{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "millennium": [
        ".millennium/lsp/ts"
      ]
    },
    "typeRoots": [
      ".millennium/types",
      "node_modules/@types"
    ]
  },
  "include": [
    "frontend/**/*",
    "src/**/*"
  ]
}